@page "/products"
@using WarehouseManager.Client.Services
@using WarehouseManager.Models
@inject ProductClientService ProductsService
@inject IJSRuntime JS

<MudText Typo="Typo.h4" Class="mb-4">Προϊόντα</MudText>


<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3">Προσθήκη προϊόντος</MudText>

    <EditForm Model="newProduct" OnValidSubmit="AddProduct">
        <DataAnnotationsValidator/>

        <ValidationSummary/>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField Label="Κωδικός"
                              @bind-Value="newProduct.SKU"
                              Variant="Variant.Outlined"/>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Label="Όνομα"
                              @bind-Value="newProduct.Name"
                              Variant="Variant.Outlined"/>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Label="Κατηγορία"
                              @bind-Value="newProduct.Category"
                              Variant="Variant.Outlined"/>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudNumericField T="decimal"
                                 Label="Τιμή"
                                 @bind-Value="newProduct.Price"
                                 Variant="Variant.Outlined"/>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudNumericField T="int"
                                 Label="Stock"
                                 @bind-Value="newProduct.Stock"
                                 Variant="Variant.Outlined"/>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudNumericField T="int"
                                 Label="Min Stock"
                                 @bind-Value="newProduct.MinStock"
                                 Variant="Variant.Outlined"/>
            </MudItem>

        </MudGrid>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Class="mt-3"
                   ButtonType="ButtonType.Submit">

            Προσθήκη
        </MudButton>

    </EditForm>


</MudPaper>


<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Προϊόντα</MudText>

    <MudTextField @bind-Value="searchTerm"
                  Style="width: 300px"
                  Immediate="true"
                  Placeholder="Αναζήτηση προϊόντος...."
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"></MudTextField>
</MudStack>


@if (isEditing && editProduct != null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-3">Επεξεργασία προϊόντος</MudText>

        <EditForm Model="editProduct" OnValidSubmit="SaveEdit">
            <DataAnnotationsValidator/>
            <ValidationSummary/>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Κωδικός"
                                  @bind-Value="editProduct.SKU"
                                  Variant="Variant.Outlined"/>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField Label="Όνομα"
                                  @bind-Value="editProduct.Name"
                                  Variant="Variant.Outlined"/>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField Label="Κατηγορία"
                                  @bind-Value="editProduct.Category"
                                  Variant="Variant.Outlined"/>
                </MudItem>

                <MudItem xs="12" md="3">
                    <MudNumericField T="decimal"
                                     Label="Τιμή"
                                     @bind-Value="editProduct.Price"
                                     Variant="Variant.Outlined"/>
                </MudItem>

                <MudItem xs="12" md="3">
                    <MudNumericField
                        T="int"
                        Label="Stock"
                        @bind-Value="editProduct.Stock"
                        Variant="Variant.Outlined"/>
                </MudItem>

                <MudItem xs="12" md="3">
                    <MudNumericField
                        T="int"
                        Label="Min Stock"
                        @bind-Value="editProduct.MinStock"
                        Variant="Variant.Outlined"/>
                </MudItem>

            </MudGrid>

            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary">
                    Αποθήκευση
                </MudButton>

                <MudButton ButtonType="ButtonType.Button"
                           Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           @onclick="CancelEdit">
                    Άκυρο
                </MudButton>
            </MudStack>
        </EditForm>
    </MudPaper>
}


@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        @successMessage
    </MudAlert>
}

@if (products == null)
{
    <MudProgressCircular Indeterminate="true" Class="my-4" />
    <MudText Typo="Typo.body1">Φόρτωση...</MudText>
}
else if (!products.Any())
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Δεν υπάρχουν προϊόντα.
    </MudAlert>
}


else
{
    <MudTable Items="filteredProducts" Hover="true" Striped="true" Bordered="true" Dense="true">
        <HeaderContent>
            <MudTh>Κωδικός</MudTh>
            <MudTh>Όνομα</MudTh>
            <MudTh>Κατηγορία</MudTh>
            <MudTh>Τιμή</MudTh>
            <MudTh>Stock</MudTh>
            <MudTh>Ενέργειες</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Κωδικός">@context.SKU</MudTd>
            <MudTd DataLabel="Όνομα">@context.Name</MudTd>
            <MudTd DataLabel="Κατηγορία">@context.Category</MudTd>
            <MudTd DataLabel="Τιμή">@context.Price.ToString("0.00") €</MudTd>
            <MudTd DataLabel="Stock">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudText>@context.Stock</MudText>

                    @if (context.Stock <= context.MinStock)
                    {
                        <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small">
                            Low
                        </MudChip>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Ενέργειες">
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   OnClick="() => StartEdit(context)" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Medium"
                                   OnClick="() => DeleteProduct(context.Id)"/>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private string searchTerm = string.Empty;

    private List<Product>? products;

    private Product? editProduct = null;
    private bool isEditing = false;

    private string? errorMessage;
    private string? successMessage;

    private IEnumerable<Product> filteredProducts =>
        products?.Where(p =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            p.SKU.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Product>();

    private void StartEdit(Product product)
    {
        editProduct = new Product
        {
            Id = product.Id,
            SKU = product.SKU,
            Name = product.Name,
            Category = product.Category,
            Price = product.Price,
            Stock = product.Stock,
            MinStock = product.MinStock
        };
        isEditing = true;
    }

    private async Task SaveEdit()
    {
        if (editProduct != null)
        {
            await ProductsService.UpdateAsync(editProduct);
            isEditing = false;
            editProduct = null;
            products = await ProductsService.GetAllAsync();
            successMessage = "Το προϊόν ενημερώθηκε!";
        }
    }

    private Product newProduct = new Product();

    private async Task AddProduct()
    {
        successMessage = null;
        errorMessage = null;
        await ProductsService.AddAsync(newProduct);
        newProduct = new Product();
        products = await ProductsService.GetAllAsync();
        successMessage = "Το προϊόν προστέθηκε!";
    }

    protected override async Task OnInitializedAsync()
    {
        products = await ProductsService.GetAllAsync();
    }

    private async Task DeleteProduct(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Είσαι σίγουρος για την διαγραφή");
        if (!confirmed) return;
        await ProductsService.DeleteAsync(id);
        products = await ProductsService.GetAllAsync();
    }

    private void CancelEdit()
    {
        isEditing = false;
        editProduct = null;
    }

}
