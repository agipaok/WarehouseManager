@page "/csv-upload"
@using WarehouseManager.Models
@inject WarehouseManager.Services.ProductService ProductService

<MudText Typo="Typo.h5" Class="mb-4">Csv Upload</MudText>

<MudFileUpload T="IBrowserFile" FilesChanged="HandleFile" Accept=".csv">
    <ActivatorContent>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.UploadFile">
            Επιλογή Csv
        </MudButton>
    </ActivatorContent>
</MudFileUpload>

@if (message != null)
{
    <MudAlert Severity="Severity.Success" Class="mt-4">@message</MudAlert>
}

@if (products != null)
{
    <MudTable Items="products" Class="mt-4" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>Όνομα</MudTh>
            <MudTh>SKU</MudTh>
            <MudTh>Κατηγορία</MudTh>
            <MudTh>Τιμή</MudTh>
            <MudTh>Stock</MudTh>
            <MudTh>Min Stock</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.SKU</MudTd>
            <MudTd>@context.Category</MudTd>
            <MudTd>@context.Price</MudTd>
            <MudTd>@context.Stock</MudTd>
            <MudTd>@context.MinStock</MudTd>
        </RowTemplate>    
    </MudTable>
}

@code
{
    private string? message;
    private Severity severity = Severity.Success;
    private List<Product>? products;

    private async Task HandleFile(IBrowserFile file)
    {
        using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var reader = new StreamReader(stream);

        var content = await reader.ReadToEndAsync();
        var allLines = content.Split('\n', StringSplitOptions.RemoveEmptyEntries);

        products = new List<Product>();

        foreach(var line in allLines.Skip(1))
        {
            var cols = line.Split(',');
            if(cols.Length < 6) continue;
            var product = new Product
            {
                Name = cols[0].Trim(),
                SKU = cols[1].Trim(),
                Category = cols[2].Trim(),
                Price = decimal.Parse(cols[3].Trim()),
                Stock = int.Parse(cols[4].Trim()),
                MinStock = int.Parse(cols[5].Trim()),
            };
            products.Add(product);
            await ProductService.AddAsync(product);
        }

        message = $"Αποθηκεύτηκαν {products.Count} προϊόντα στην βάση";
    }
}
