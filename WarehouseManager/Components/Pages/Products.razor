@page "/products"
@using WarehouseManager.Services
@using WarehouseManager.Models
@inject ProductService ProductsService
@rendermode InteractiveServer
@inject IJSRuntime JS

<h3>Προϊόντα</h3>


<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb=3">Προσθήκη προϊόντος</MudText>
    
    <EditForm Model="newProduct" OnValidSubmit="AddProduct">
        <DataAnnotationsValidator/>
        
        <ValidationSummary/>
    
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField Label="Κωδικός"
                              @bind-Value="newProduct.SKU"
                              Variant="Variant.Outlined"/>
            </MudItem>
        
            <MudItem xs="12" md="6">
                <MudTextField Label="Όνομα"
                              @bind-Value="newProduct.Name"
                              Variant="Variant.Outlined"/>
            </MudItem>
        
            <MudItem xs="12" md="6">
                <MudTextField Label="Κατηγορία"
                              @bind-Value="newProduct.Category"
                              Variant="Variant.Outlined"/>
            </MudItem>
        
            <MudItem xs="12" md="3">
                <MudTextField Label="Τιμή"
                              @bind-Value="newProduct.Price"
                              Variant="Variant.Outlined"/>
            </MudItem>
        
            <MudItem xs="12" md="3">
                <MudTextField Label="Stock"
                              @bind-Value="newProduct.Stock"
                              Variant="Variant.Outlined"/>
            </MudItem>
        
            <MudItem xs="12" md="3">
                <MudTextField Label="Min Stock"
                              @bind-Value="newProduct.MinStock"
                              Variant="Variant.Outlined"/>
            </MudItem>
    
        </MudGrid>
        
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   class="mt-3"
                   ButtonType="ButtonType.Submit">
    
            Προσθήκη
        </MudButton>
    
    </EditForm>
    
    
</MudPaper>


<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Προϊόντα</MudText>
    
    <MudTextField @bind-Value="searchTerm"
                  Style="width: 300px"
                  Immediate="true"
                  Placeholder="Αναζήτηση προϊόντος...."
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"></MudTextField>
</MudStack>

@if (isEditing && editProduct != null)
{
    <div class="warehouse-form">
        <EditForm Model="editProduct" OnValidSubmit="SaveEdit">
            <DataAnnotationsValidator /> 
            <ValidationSummary/>
            <InputText @bind-Value="editProduct.SKU" placeholder="Κωδικός"/>
            <ValidationMessage For="@(() => editProduct.SKU)" />
            <InputText @bind-Value="editProduct.Name" placeholder="Όνομα" />
            <ValidationMessage For="@(() => editProduct.Name)" />

            <InputText @bind-Value="editProduct.Category" placeholder="Κατηγορία" />

            <InputNumber @bind-Value="editProduct.Price" placeholder="Τιμή" />
            <ValidationMessage For="@(() => editProduct.Price)" />

            <InputNumber @bind-Value="editProduct.Stock" placeholder="Stock" />
            <ValidationMessage For="@(() => editProduct.Stock)" />

            <InputNumber @bind-Value="editProduct.MinStock" placeholder="Ελάχιστο Stock" />
            <ValidationMessage For="@(() => editProduct.MinStock)" />
            <button type="submit">Αποθήκευση</button>
            <button type="button" @onclick="() => isEditing = false">Άκυρο</button>
        </EditForm>
    </div>
}

@if (errorMessage != null)
{
    <p style="color: red;">@errorMessage</p>
}
@if (successMessage != null)
{
    <p style="color: green;">@successMessage</p>
}

@if (products == null)
{
    <p>Φόρτωση...</p>
}

else if (!products.Any())
{
    <p>Δεν υπάρχουν προϊόντα.</p>
}

else
{
    <table class="warehouse-table">
        <thead>
        <tr>
            <th>
                Κωδικός
            </th>
            <th>
                Όνομα
            </th>
            <th>
                Κατηγορία
            </th>
            <th>
                Τιμή
            </th>
            <th>
                Stock
            </th>
            <th>
                Ενέργειες
            </th>
        </tr>
        </thead>
        <tbody>
        @foreach (var product in products.Where(p => string.IsNullOrEmpty(searchTerm) || 
                                                     p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                                     p.SKU.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
        {
            <tr>
                <td>
                    @product.SKU
                </td>
                <td>
                    @product.Name
                </td>
                <td>
                    @product.Category
                </td>
                <td>
                    @product.Price €
                </td>
                <td>
                    @product.Stock
                </td>
                <td>
                    <button class="btn-delete" @onclick="() => DeleteProduct(product.Id)">Διαγραφή</button>
                    <button @onclick="() => StartEdit(product)">Επεξεργασία</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
@code {
    private string searchTerm = string.Empty;

    private List<Product>? products;

    private Product? editProduct = null;
    private bool isEditing = false;

    private string? errorMessage;
    private string? successMessage;

    private void StartEdit(Product product)
    {
        editProduct = new Product
        {
            Id = product.Id,
            SKU = product.SKU,
            Name = product.Name,
            Category = product.Category,
            Price = product.Price,
            Stock = product.Stock,
            MinStock = product.MinStock
        };
        isEditing = true;
    }

    // Δημιουργουμε ενα αντιγραφο οταν αρχισουμε να κανουμε edit ! Ωστε αν πατησουμε cancel να υπαρχει το παλιο
    private async Task SaveEdit()
    {
        if (editProduct != null)
        {
            await ProductsService.UpdateAsync(editProduct);
            isEditing = false;
            editProduct = null;
            products = await ProductsService.GetAllAsync();
            successMessage = "Το προϊόν ενημερώθηκε!";
        }
    }

    private Product newProduct = new Product();

    private async Task AddProduct()
    {
        successMessage = null;
        errorMessage = null;
        await ProductsService.AddAsync(newProduct);
        newProduct = new Product();
        products = await ProductsService.GetAllAsync();
        successMessage = "Το προϊόν προστέθηκε!";
    }

    protected override async Task OnInitializedAsync()
    {
        products = await ProductsService.GetAllAsync();

    }

    private async Task DeleteProduct(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Είσαι σίγουρος για την διαγραφή");
        if (!confirmed) return;
        await ProductsService.DeleteAsync(id);
        products = await ProductsService.GetAllAsync();
    }
    
}