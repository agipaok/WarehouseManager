@page "/stock-movements"
@using WarehouseManager.Services
@using WarehouseManager.Models
@inject StockMovementService MovementService
@inject ProductService ProductService
@rendermode InteractiveServer

<MudText Typo="Typo.h4" Class="mb-4">Κινήσεις αποθήκης</MudText>


<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3">Νέα Κίνηση</MudText>
    
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudSelect T="int"
                       Label="Προϊόν"
                       @bind-Value="newMovement.ProductId"
                       Variant="Variant.Outlined">
                <MudSelectItem Value="0">--Επιλέξτε προϊόν</MudSelectItem>
                @foreach (var product in products ?? Enumerable.Empty<Product>())
                {
                    <MudSelectItem Value="@product.Id">@product.Name (@product.SKU)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        
        <MudItem xs="12" md="6">
            <MudSelect T="string"
                       Label="Τύπος κίνησης"
                       @bind-Value="newMovement.MovementType"
                       Variant="Variant.Outlined">
                <MudSelectItem Value=@("IN")>IN - Εισαγωγή</MudSelectItem>
                <MudSelectItem Value=@("OUT")>OUT - Εξαγωγή</MudSelectItem>
            </MudSelect>
        </MudItem>
        
        <MudItem xs="12" md="6">
            <MudNumericField T="int"
                             Label="Ποσότητα"
                             @bind-Value="newMovement.Quantity"
                             Variant="Variant.Outlined"/>
        </MudItem>
        
        <MudItem xs="12" md="6">
            <MudTextField Label="Σημειώσεις"
                          @bind-Value="newMovement.Notes"
                          Variant="Variant.Outlined"/>
        </MudItem>
        
    </MudGrid>
    
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mt-3"
               OnClick="AddMovement">
        Καταχώρηση
    </MudButton>
</MudPaper>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        @successMessage
    </MudAlert>
}

@if (movements == null)
{
    <MudProgressCircular Indeterminate="true" Class="my-4"/>
    <MudText Typo="Typo.body1">Φόρτωση...</MudText>
}
else if (!movements.Any())
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Δεν υπάρχουν κινήσεις.
    </MudAlert>
}
else
{
    <MudTable Items="movements" Hover="true" Striped="true" Bordered="true" Dense="true">
        
        <HeaderContent>
            <MudTh>Ημερομηνία</MudTh>
            <MudTh>Προϊόν</MudTh>
            <MudTh>Τύπος</MudTh>
            <MudTh>Ποσότητα</MudTh>
            <MudTh>Σημειώσεις</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Ημερομηνία">
                @context.CreatedAt.ToString("dd/MM/yyyy HH:mm")
            </MudTd>
            
            <MudTd DataLabel="Προϊόν">
                @context.Product?.Name
            </MudTd>
            
            <MudTd DataLabel="Τύπος">
                <MudChip T="string"
                         Color="@(context.MovementType == "IN" ? Color.Success : Color.Error)"
                         Variant="Variant.Filled"
                         Size="Size.Small">
                    @context.MovementType
                </MudChip>
            </MudTd>
            
            <MudTd DataLabel="Ποσότητα">
                @context.Quantity
            </MudTd>
            
            <MudTd DataLabel="Σημειώσεις">
                @context.Notes
            </MudTd>
        </RowTemplate>
    </MudTable>
    
    
}

@code {
    private List<StockMovement>? movements;
    private List<Product>? products;
    private string? errorMessage;
    private string? successMessage;

    private StockMovement newMovement = new StockMovement
    {
        MovementType = "IN"
    };

    protected override async Task OnInitializedAsync()
    {
        movements = await MovementService.GetAllAsync();
        products = await ProductService.GetAllAsync();
    }

    private async Task AddMovement()
    {
        errorMessage = null;
        successMessage = null;
        if (newMovement.ProductId == 0)
        {
            errorMessage = "Επιλέξτε προϊόν!";
            return;
        }

        var result = await MovementService.AddAsync(newMovement);
        if (result)
        {
            successMessage = "Η κίνηση καταχωρήθηκε!";
            newMovement = new StockMovement { MovementType = "IN" };
            movements = await MovementService.GetAllAsync();
            products = await ProductService.GetAllAsync();
        }
        else
        {
            errorMessage = "Δεν υπάρχει αρκετό stock για OUT κίνηση!";
        }

    }

}