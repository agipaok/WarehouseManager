@page "/suppliers"
@using WarehouseManager.Services
@using WarehouseManager.Models
@inject SupplierService SupplierService
@rendermode InteractiveServer
@inject IJSRuntime JS

<h3>Προμηθευτές</h3>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3">Προσθήκη προμηθευτή</MudText>
    
    <EditForm Model="newSupplier" OnValidSubmit="AddSupplier">
        <DataAnnotationsValidator/>
        <ValidationSummary/>
        
        <MudGrid>
        
            <MudItem xs="12" md="6">
                <MudTextField Label="Επωνυμία"
                              @bind-Value="newSupplier.Name"
                              Variant="Variant.Outlined"/>
            </MudItem>
        
            <MudItem xs="12" md="6">
                <MudTextField Label="Υπεύθυνος"
                              @bind-Value="newSupplier.ContactPerson"
                              Variant="Variant.Outlined"/>
            </MudItem>
        
            <MudItem xs="12" md="6">
                <MudTextField Label="Τηλέφωνο"
                              InputType="InputType.Telephone"
                              @bind-Value="newSupplier.Phone"
                              Variant="Variant.Outlined"/>
            </MudItem>
        
            <MudItem xs="12" md="6">
                <MudTextField Label="Email"
                              InputType="InputType.Email"
                              @bind-Value="newSupplier.Email"
                              Variant="Variant.Outlined"/>
            </MudItem>
        </MudGrid>
        
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Class="mt-3"
                   ButtonType="ButtonType.Submit">
            Προσθήκη
        </MudButton>
    </EditForm>
</MudPaper>


@if (isEditing && editSupplier != null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-3">Επεξεργασία προμηθευτή</MudText>
        
        <EditForm Model="editSupplier" OnValidSubmit="SaveEdit">
            <DataAnnotationsValidator/>
            <ValidationSummary/>
            
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Επωνυμία"
                                  @bind-Value="editSupplier.Name"
                                  Variant="Variant.Outlined"/>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField Label="Υπεύθυνος"
                                  @bind-Value="editSupplier.ContactPerson"
                                  Variant="Variant.Outlined"/>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField Label="Τηλέφωνο"
                                  InputType="InputType.Telephone"
                                  @bind-Value="editSupplier.Phone"
                                  Variant="Variant.Outlined"/>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField Label="Email"
                                  InputType="InputType.Email"
                                  @bind-Value="editSupplier.Email"
                                  Variant="Variant.Outlined"/>
                </MudItem>
            </MudGrid>
            
            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary">
                    Αποθήκευση
                </MudButton>
                
                <MudButton ButtonType="ButtonType.Button"
                           Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           @onclick="CancelEdit">
                    Άκυρο
                </MudButton>
            </MudStack>
        </EditForm>
    </MudPaper>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        @successMessage
    </MudAlert>
}

@if (suppliers == null)
{
    <MudProgressCircular Indeterminate="true" Class="my-4" />
    <MudText Typo="Typo.body1">Φόρτωση...</MudText>
}

else if (!suppliers.Any())
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Δεν υπάρχουν προμηθευτές.
    </MudAlert>
}

else
{
    <MudTable Items="suppliers" Hover="true" Striped="true" Bordered="true" Dense="true">
        <HeaderContent>
            <MudTh>Επωνυμία</MudTh>
            <MudTh>Υπεύθυνος</MudTh>
            <MudTh>Τηλέφωνο</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Ενέργειες</MudTh>
        </HeaderContent>
        
        <RowTemplate>
            <MudTd DataLabel="Επωνυμία">@context.Name</MudTd>
            <MudTd DataLabel="Υπεύθυνος">@context.ContactPerson</MudTd>
            <MudTd DataLabel="Τηλέφωνο">@context.Phone</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Ενέργειες">
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   OnClick="() => StartEdit(context)"/>
                        
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Medium"
                                   OnClick="() => DeleteSupplier(context.Id)"/>
                </MudStack>
            </MudTd>    
        </RowTemplate>

    </MudTable>
}

@code {
    private List<Supplier>? suppliers;
    private Supplier newSupplier = new Supplier();
    private Supplier? editSupplier = null;
    private bool isEditing = false;
    private string? errorMessage;
    private string? successMessage;

    private void CancelEdit()
    {
        isEditing = false;
        editSupplier = null;
    }

    private async Task LoadSuppliersAsync()
    {
        suppliers = await SupplierService.GetAllAsync();
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliersAsync();
    }

    private async Task AddSupplier()
    {
        ClearMessages();
        await SupplierService.AddAsync(newSupplier);
        newSupplier = new Supplier();
        await LoadSuppliersAsync();
        successMessage = "Ο προμηθευτής καταχωρήθηκε!";
    }

    private void StartEdit(Supplier supplier)
    {
        editSupplier = new Supplier
        {
            Id = supplier.Id,
            Name = supplier.Name,
            ContactPerson = supplier.ContactPerson,
            Phone = supplier.Phone,
            Email = supplier.Email
        };
        isEditing = true;
    }

    private async Task SaveEdit()
    {
            if (editSupplier == null)
                return;
            
            ClearMessages();
            
            await SupplierService.UpdateAsync(editSupplier);
            CancelEdit();
            await LoadSuppliersAsync();
            successMessage = "Ο προμηθευτής ενημερώθηκε!";
            
        
    }

    private async Task DeleteSupplier(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Είσαι σίγουρος για την διαγραφή");
        if (!confirmed) return;
        ClearMessages();
        
        await SupplierService.DeleteAsync(id);
        await LoadSuppliersAsync();
        successMessage = "Ο προμηθευτής διαγράφηκε!";

    }

}