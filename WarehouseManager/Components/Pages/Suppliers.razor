@page "/suppliers"
@using WarehouseManager.Services
@using WarehouseManager.Models
@inject SupplierService SupplierService
@rendermode InteractiveServer
@inject IJSRuntime JS

<h3>Προμηθευτές</h3>

<div class="warehouse-form">
    <h4>Προμηθευτή</h4>
    <EditForm Model="newSupplier" OnValidSubmit="AddSupplier">
        <DataAnnotationsValidator/>
        <InputText @bind-Value="newSupplier.Name" placeholder="Επωνυμία"/>
        <ValidationMessage For="() => newSupplier.Name"/>
        <InputText @bind-Value="newSupplier.ContactPerson" placeholder="Υπεύθυνος"/>
        <ValidationMessage For="() => newSupplier.ContactPerson"/>
        <InputText @bind-Value="newSupplier.Phone" placeholder="Τηλέφωνο"/>
        <ValidationMessage For="() => newSupplier.Phone"/>
        <InputText @bind-Value="newSupplier.Email" placeholder="Email"/>
        <ValidationMessage For="() => newSupplier.Email"/>
        <button type="submit">Προσθήκη</button>
    </EditForm>
</div>


@if (isEditing && editSupplier != null)
{
    <div class="warehouse-form">
        <h4>Επεξεργασία προμηθευτή</h4>
        <EditForm Model="editSupplier" OnValidSubmit="SaveEdit">
            <DataAnnotationsValidator/>
            <InputText @bind-Value="editSupplier.Name" placeholder="Επωνυμία"/>
            <ValidationMessage For="() => editSupplier.Name"/>
            <InputText @bind-Value="editSupplier.ContactPerson" placeholder="Υπεύθυνος"/>
            <ValidationMessage For="() => editSupplier.ContactPerson"/>
            <InputText @bind-Value="editSupplier.Phone" placeholder="Τηλέφωνο"/>
            <ValidationMessage For="() => editSupplier.Phone"/>
            <InputText @bind-Value="editSupplier.Email" placeholder="Email"/>
            <ValidationMessage For="() => editSupplier.Email"/>
            <button type="submit">Αποθήκευση</button>
            <button type="button" @onclick="() => isEditing = false">Άκυρο</button>
        </EditForm>
    </div>
}

@if (errorMessage != null)
{
    <p style="color: red;">@errorMessage</p>
}
@if (successMessage != null)
{
    <p style="color: green;">@successMessage</p>
}

@if (suppliers == null)
{
    <p>φόρτωση....</p>
}
else if (!suppliers.Any())
{
    <p>Δεν υπάρχουν προμηθευτές.</p>
}
else
{
    <table class="warehouse-table">
        <thead>
        <tr>
            <th>Επωνυμία</th>
            <th>Υπεύθυνος</th>
            <th>Τηλέφωνο</th>
            <th>Email</th>
            <th>Ενέργειες</th>
        </tr>
        </thead>
        <tbody>
    
    @foreach (var supplier in suppliers)
    {
        <tr>
            <td>@supplier.Name</td>
            <td>@supplier.ContactPerson</td>
            <td>@supplier.Phone</td>
            <td>@supplier.Email</td>
            <td>
                <button @onclick="() => StartEdit(supplier)">Επεξεργασία</button>
                <button class="btn-delete" @onclick="() => DeleteSupplier(supplier.Id)">Διαγραφή</button>
            </td>
        </tr>
    }
        </tbody>
    </table>
}

@code {
    private List<Supplier>? suppliers;
    private Supplier newSupplier = new Supplier();
    private Supplier? editSupplier = null;
    private bool isEditing = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        suppliers = await SupplierService.GetAllAsync();
    }

    private async Task AddSupplier()
    {
        successMessage = null;
        errorMessage = null;
        await SupplierService.AddAsync(newSupplier);
        newSupplier = new Supplier();
        suppliers = await SupplierService.GetAllAsync();
        successMessage = "Ο προμηθευτής καταχωρήθηκε!";
    }

    private void StartEdit(Supplier supplier)
    {
        editSupplier = new Supplier
        {
            Id = supplier.Id,
            Name = supplier.Name,
            ContactPerson = supplier.ContactPerson,
            Phone = supplier.Phone,
            Email = supplier.Email
        };
        isEditing = true;
    }

    private async Task SaveEdit()
    {
        if (editSupplier != null)
        {
            await SupplierService.UpdateAsync(editSupplier);
            isEditing = false;
            editSupplier = null;
            suppliers = await SupplierService.GetAllAsync();
            successMessage = "Ο προμηθευτής ενημερώθηκε!";
            
        }
    }

    private async Task DeleteSupplier(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Είσαι σίγουρος για την διαγραφή");
        if (!confirmed) return;
        await SupplierService.DeleteAsync(id);
        suppliers = await SupplierService.GetAllAsync();
        
    }

}